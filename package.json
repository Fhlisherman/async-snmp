{
  "name": "async-snmp",
  "version": "1.0.0",
  "description": "[![npm version](https://img.shields.io/npm/v/async-snmp.svg)](https://www.npmjs.com/package/async-snmp)",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --out-dir dist --clean --external net-snmp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fhlisherman/async-snmp.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Fhlisherman/async-snmp/issues"
  },
  "homepage": "https://github.com/Fhlisherman/async-snmp#readme",
  "devDependencies": {
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^24.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "net-snmp": "^3.26.0"
  }
}
